# Copy intentionally is NOT performed automatically. Never overwrite an existing .env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://k12r1_app:CHANGE_ME_DEV@127.0.0.1:55433/k12r1_dev
TEST_DATABASE_URL=postgresql+asyncpg://k12r1_test:CHANGE_ME_TEST@127.0.0.1:55434/k12r1_test
POSTGRES_DEV_PASSWORD=CHANGE_ME_DEV
POSTGRES_TEST_PASSWORD=CHANGE_ME_TEST
ALLOWED_ORIGINS=http://127.0.0.1:15173
APP_SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=1
# Real Knodo mode is opt-in. PAT stays in the server process environment and
# must never be committed. The durable ledger counts a request before sending
# it and does not reset after a restart. Current T11/T13 authorisation: max 20.
GATEWAY_MODE=disabled
KNODO_BASE_URL=https://knodo.vip
KNODO_PAT=
KNODO_TUTOR_BOT_ID=
KNODO_TUTOR_WORKSPACE_ID=
KNODO_DESIGNER_BOT_ID=
KNODO_DESIGNER_WORKSPACE_ID=
KNODO_MAX_REQUESTS=0
KNODO_BUDGET_LEDGER_PATH=storage/private/knodo-request-budget.json
T05_DEMO_STUDENT_A_USERNAME=demo.student.a
T05_DEMO_STUDENT_A_PASSWORD=CHANGE_ME_SYNTHETIC_A
T05_DEMO_STUDENT_B_USERNAME=demo.student.b
T05_DEMO_STUDENT_B_PASSWORD=CHANGE_ME_SYNTHETIC_B
T05_DEMO_ADMIN_USERNAME=demo.admin
T05_DEMO_ADMIN_PASSWORD=CHANGE_ME_SYNTHETIC_ADMIN
