{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "k12.designer.request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "operation": {
      "enum": [
        "QUIZ_DRAFT",
        "LESSON_PACKAGE_DRAFT"
      ]
    },
    "chapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "curriculum_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "stage": {
      "enum": [
        "PRIMARY_LOWER",
        "PRIMARY_UPPER",
        "JUNIOR",
        "SENIOR"
      ]
    },
    "objective_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true
    },
    "knowledge_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        },
        "required": [
          "source_id",
          "revision",
          "locator",
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "allowed_resource_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "minItems": 0,
      "maxItems": 20,
      "uniqueItems": true
    },
    "quiz_spec": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "difficulty": {
              "enum": [
                "EASY",
                "MEDIUM",
                "HARD"
              ]
            },
            "question_types": {
              "type": "array",
              "items": {
                "enum": [
                  "SINGLE_CHOICE",
                  "TRUE_FALSE",
                  "ORDERING"
                ]
              },
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true
            },
            "misconception_summary": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1500
            }
          },
          "required": [
            "count",
            "difficulty",
            "question_types",
            "misconception_summary"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lesson_spec": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_animation_templates": {
              "type": "array",
              "items": {
                "enum": [
                  "ADJACENT_SORT",
                  "BINARY_SEARCH"
                ]
              },
              "minItems": 0,
              "maxItems": 2,
              "uniqueItems": true
            },
            "asset_requests_allowed": {
              "type": "boolean"
            },
            "author_instruction": {
              "type": "string",
              "minLength": 0,
              "maxLength": 3000
            }
          },
          "required": [
            "allowed_animation_templates",
            "asset_requests_allowed",
            "author_instruction"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "operation",
    "chapter_id",
    "curriculum_revision",
    "stage",
    "objective_ids",
    "knowledge_context",
    "allowed_resource_ids",
    "quiz_spec",
    "lesson_spec"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "本地Designer请求，不含学生身份，不是Knodo wire",
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "QUIZ_DRAFT"
          }
        }
      },
      "then": {
        "properties": {
          "quiz_spec": {
            "type": "object"
          },
          "lesson_spec": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "quiz_spec": {
            "type": "null"
          },
          "lesson_spec": {
            "type": "object"
          }
        }
      }
    }
  ]
}
