{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "k12.lesson.package.draft.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "chapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "curriculum_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "stage": {
      "enum": [
        "PRIMARY_LOWER",
        "PRIMARY_UPPER",
        "JUNIOR",
        "SENIOR"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1,
      "maxItems": 8
    },
    "teaching_script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "READ",
              "RESOURCE",
              "ANIMATION",
              "QUIZ",
              "CODE",
              "REFLECT"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "suggested_resource_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "instruction",
          "suggested_resource_id"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "animation_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "template": {
            "enum": [
              "ADJACENT_SORT",
              "BINARY_SEARCH"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 12
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "source_id",
                "revision",
                "locator"
              ]
            },
            "minItems": 1,
            "maxItems": 4
          }
        },
        "required": [
          "template",
          "values",
          "target",
          "narration",
          "source_refs"
        ]
      },
      "minItems": 0,
      "maxItems": 4
    },
    "asset_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "WORD",
              "PPT",
              "VIDEO",
              "IMAGE"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "status": {
            "const": "NOT_PROVIDED"
          },
          "source_requirement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        },
        "required": [
          "kind",
          "description",
          "status",
          "source_requirement"
        ]
      },
      "minItems": 0,
      "maxItems": 12
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "source_id",
          "revision",
          "locator"
        ]
      },
      "minItems": 1,
      "maxItems": 8
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "minItems": 0,
      "maxItems": 12
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "chapter_id",
    "curriculum_revision",
    "stage",
    "title",
    "objectives",
    "teaching_script",
    "activities",
    "animation_specs",
    "asset_requests",
    "source_refs",
    "warnings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "结构化课程包草稿；asset_requests仅需求，不是已生成文件"
}
