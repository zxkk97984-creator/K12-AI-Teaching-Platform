      },
      "ReadingEventKind": {
        "type": "string",
        "enum": [
          "ENTER",
          "SECTION_VIEW",
          "BLOCK_VIEW",
          "SELECT_TEXT",
          "RESUME",
          "LEAVE"
        ],
        "title": "ReadingEventKind",
        "description": "Behaviour only. There is no mastery/completion value in this enum."
      },
      "ReadingEventReceipt": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Recorded At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "duplicate",
          "recorded_at"
        ],
        "title": "ReadingEventReceipt"
      },
      "ReadingEventRequest": {
        "properties": {
          "client_event_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9._:-]{8,64}$",
            "title": "Client Event Id"
          },
          "chapter_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chapter Id"
          },
          "revision": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Revision"
          },
          "event_kind": {
            "$ref": "#/components/schemas/ReadingEventKind"
          },
          "section_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Key"
          },
          "block_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8,
                "pattern": "^b[0-9]{1,4}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Block Id"
          },
          "selected_text_length": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 500.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Text Length"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_event_id",
          "chapter_id",
          "revision",
          "event_kind"
        ],
        "title": "ReadingEventRequest"
      },
      "ReadingStateDTO": {
        "properties": {
          "chapter_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chapter Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "revision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Revision Id"
          },
          "event_kind": {
            "$ref": "#/components/schemas/ReadingEventKind"
          },
          "section_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section Key"
          },
          "block_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Block Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "is_current_revision": {
            "type": "boolean",
            "title": "Is Current Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "chapter_id",
          "revision",
          "revision_id",
          "event_kind",
          "section_key",
          "block_id",
          "created_at",
          "is_current_revision"
        ],
        "title": "ReadingStateDTO"
      },
      "RenderedBlock": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/BlockType"
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 2,
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key"
          },
          "mark": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Mark"
          },
          "caption": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Caption"
          },
          "alt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Alt"
          },
          "src": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "pattern": "^assets/[A-Za-z0-9._-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Src"
          },
          "example": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExampleSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "block_id": {
            "type": "string",
            "maxLength": 8,
            "pattern": "^b[0-9]{1,4}$",
            "title": "Block Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "block_id"
        ],
        "title": "RenderedBlock",
        "description": "A validated content block plus the stable per-revision block id.\n\nBlock ids are positional (``b1``..``bN``) inside an immutable revision, so\na client can reference a block without inventing or rewriting content."
      },
      "ReviewStatus": {
        "type": "string",
        "enum": [
          "UNREVIEWED",
          "AUTO_VALIDATED",
          "HUMAN_APPROVED"
        ],
        "title": "ReviewStatus"
      },
      "SourceKind": {
        "type": "string",
        "enum": [
          "LEGACY_REUSED",
          "NEW_SOURCE",
          "SYNTHETIC_FIXTURE"
        ],
        "title": "SourceKind"
      },
      "SourceRefDTO": {
        "properties": {
          "source_kind": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceKind"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Commit"
          },
          "source_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Path"
          },
          "conversion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversion"
          },
          "license_code": {
            "$ref": "#/components/schemas/LicenseCode"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_kind",
          "source_commit",
          "source_path",
          "conversion",
          "license_code"
        ],
        "title": "SourceRefDTO",
        "description": "Whitelisted provenance for the reader.\n\nThe raw stored manifest is deliberately not returned: students only need\nwhere the text came from and under which license, not internal review keys,\ncontent hashes or archive identifiers."
      },
      "Stage": {
        "type": "string",
        "enum": [
          "PRIMARY_LOWER",
          "PRIMARY_UPPER",
          "JUNIOR",
          "SENIOR"
        ],
        "title": "Stage"
      },
      "UnknownBlockDTO": {
        "properties": {
          "block_id": {
            "type": "string",
            "maxLength": 8,
            "pattern": "^b[0-9]{1,4}$",
            "title": "Block Id"
          },
          "type": {
            "type": "string",
            "const": "UNSUPPORTED",
            "title": "Type",
            "default": "UNSUPPORTED"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "block_id",
          "reason"
        ],
        "title": "UnknownBlockDTO",
        "description": "Controlled placeholder for a stored block that no longer validates.\n\nThe raw payload is intentionally not echoed: the reader shows the position\nand a reason instead of rendering unreviewed content."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
