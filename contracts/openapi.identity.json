  "components": {
    "schemas": {
      "AdminStatus": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "active_students": {
            "type": "integer",
            "title": "Active Students"
          },
          "active_sessions": {
            "type": "integer",
            "title": "Active Sessions"
          },
          "capabilities": {
            "additionalProperties": true,
            "type": "object",
            "title": "Capabilities"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "active_students",
          "active_sessions",
          "capabilities"
        ],
        "title": "AdminStatus"
      },
      "AuthResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDTO"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "preferences": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PreferencesDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user",
          "profile",
          "preferences",
          "csrf_token"
        ],
        "title": "AuthResponse"
      },
      "CsrfResponse": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "csrf_token"
        ],
        "title": "CsrfResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "MeResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDTO"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProfileDTO"
              },
              {
                "type": "null"
              }
            ]
          },
          "preferences": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PreferencesDTO"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user",
          "profile",
          "preferences"
        ],
        "title": "MeResponse"
      },
      "PreferencesDTO": {
        "properties": {
          "preferred_style": {
            "$ref": "#/components/schemas/PreferredStyle"
          },
          "interests": {
            "items": {
              "type": "string",
              "maxLength": 40,
              "minLength": 1
            },
            "type": "array",
            "title": "Interests"
          },
          "proactive_guidance_enabled": {
            "type": "boolean",
            "title": "Proactive Guidance Enabled"
          },
          "voice_preference": {
            "$ref": "#/components/schemas/VoicePreference"
          },
          "profile_revision": {
            "type": "integer",
            "title": "Profile Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "preferred_style",
          "interests",
          "proactive_guidance_enabled",
          "voice_preference",
          "profile_revision"
        ],
        "title": "PreferencesDTO"
      },
      "PreferencesPatch": {
        "properties": {
          "base_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Revision"
          },
          "preferred_style": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PreferredStyle"
              },
              {
                "type": "null"
              }
            ]
          },
          "interests": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 40,
                  "minLength": 1
                },
                "type": "array",
                "maxItems": 10
              },
              {
                "type": "null"
              }
            ],
            "title": "Interests"
          },
          "proactive_guidance_enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Proactive Guidance Enabled"
          },
          "voice_preference": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VoicePreference"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_revision"
        ],
        "title": "PreferencesPatch"
      },
      "PreferredStyle": {
        "type": "string",
        "enum": [
          "AUTO",
          "EXAMPLE",
          "VISUAL",
          "STORY",
          "STEP_BY_STEP",
          "CODE"
        ],
        "title": "PreferredStyle"
      },
      "ProfileDTO": {
        "properties": {
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ]
          },
          "grade": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "onboarding_completed": {
            "type": "boolean",
            "title": "Onboarding Completed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stage",
          "grade",
          "revision",
          "onboarding_completed"
        ],
        "title": "ProfileDTO"
      },
      "ProfilePatch": {
        "properties": {
          "base_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Base Revision"
          },
          "stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Stage"
              },
              {
                "type": "null"
              }
            ]
          },
          "grade": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 12.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Grade"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_revision"
        ],
        "title": "ProfilePatch"
      },
      "Stage": {
        "type": "string",
        "enum": [
          "PRIMARY_LOWER",
          "PRIMARY_UPPER",
          "JUNIOR",
          "SENIOR"
        ],
        "title": "Stage"
      },
      "UserDTO": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "username",
          "role",
          "is_active"
        ],
        "title": "UserDTO"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "student",
          "admin"
        ],
        "title": "UserRole"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VoicePreference": {
        "type": "string",
        "enum": [
          "DISABLED",
          "INPUT_ONLY",
          "OUTPUT_ONLY",
          "INPUT_AND_OUTPUT"
        ],
        "title": "VoicePreference"
      }
    }
  }
}
