{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k12.local/contracts/grading-result.v1.schema.json",
  "title": "K12 trusted deterministic grading result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_revision",
    "status",
    "deterministic_tests_available",
    "deterministic_score",
    "score_scale",
    "groups",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "k12.grading-result.v1"},
    "task_id": {"type": "string"},
    "task_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["PASSED", "PARTIAL", "FAILED", "NOT_VERIFIED", "SYSTEM_ERROR"]},
    "deterministic_tests_available": {"type": "boolean"},
    "deterministic_score": {"type": ["number", "null"], "minimum": 0, "maximum": 70},
    "score_scale": {"const": 70},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "max_score", "passed", "failed", "errors", "score"],
        "properties": {
          "id": {"type": "string"},
          "dimension": {"enum": ["F", "R"]},
          "max_score": {"type": "number", "exclusiveMinimum": 0},
          "passed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0},
          "errors": {"type": "integer", "minimum": 0},
          "score": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {"type": "string", "maxLength": 200}
    }
  }
}
