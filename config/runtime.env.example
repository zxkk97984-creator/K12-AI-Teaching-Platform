# ./k12 setup creates this configuration outside the repository.
# The real file is ~/.config/k12/runtime.env, mode 600, and must never be committed.
# Values are literal text: do not add shell syntax, quotes, or `export`.

POSTGRES_DEV_PASSWORD=CHANGE_ME_LOCAL_DEV
POSTGRES_TEST_PASSWORD=CHANGE_ME_LOCAL_TEST
APP_SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENV=development
ALLOWED_ORIGINS=http://127.0.0.1:15173
COOKIE_SECURE=false

GATEWAY_MODE=fixture
KNODO_BASE_URL=https://knodo.vip
KNODO_PAT=
KNODO_TUTOR_BOT_ID=c15bd075-cf3b-422f-9655-b88a3c259769
KNODO_TUTOR_WORKSPACE_ID=cmu93gg8q00xia0ns0cm1ugq8
KNODO_DESIGNER_BOT_ID=23caf7d4-d416-45f8-b1d1-6086b59a1ae5
KNODO_DESIGNER_WORKSPACE_ID=cmu93fuj000x5a0nsgzvf1iq7
# 0 allows unlimited local calls; a positive number enables a durable cap.
KNODO_MAX_REQUESTS=0
KNODO_BUDGET_LEDGER_PATH=/app/backend/storage/private/knodo-runtime-budget.json
GATEWAY_TIMEOUT_SECONDS=120
KNODO_STREAM_TIMEOUT_SECONDS=300
TEACHING_AUTORUN=true
AUTHORING_AUTORUN=true

CODELAB_RUNNER_URL=
CODELAB_RUNNER_TOKEN=
# `./k12 dev --with-runner` starts the loopback runner for CodeLab.
# The API never receives Docker access.
RUNNER_CONTROL_TOKEN=
RUNNER_IMAGE=k12-codelab-runner:0.1.0
