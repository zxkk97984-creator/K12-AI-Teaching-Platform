{
  "name": "shuangling-k12-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 15173",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 15173",
    "generate:identity": "openapi-typescript ../contracts/openapi.identity.json -o src/shared/types/generated/identity.ts",
    "test:e2e:identity": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.ui.config.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "katex": "^0.18.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
